VITE_API_BASE_URL=/api/v1
# Vite dev proxy target; change if your backend runs on another local port.
SAFARNAMA_BACKEND_ORIGIN=http://localhost:8000
VITE_STOPS_PATH=/stops
VITE_JOURNEYS_PATH=/journeys
VITE_CROWDING_PATH=/crowding
VITE_ANALYTICS_PATH=/analytics
VITE_ROUTES_PATH=/routes

# Compose defaults bind the demo to the deployment machine only.
SAFARNAMA_SITE_ADDRESS=:80
SAFARNAMA_HTTP_BIND=127.0.0.1:8080
SAFARNAMA_HTTPS_BIND=127.0.0.1:8443
# Comma-separated HTTPS frontend origins for separate hosting. Leave empty behind Caddy.
SAFARNAMA_CORS_ORIGINS=
SAFARNAMA_LOG_LEVEL=INFO

# Relative to VITE_API_BASE_URL.
VITE_HISTORICAL_DEMAND_PATH=/demand/historical

SAFARNAMA_JOURNEY_CONCURRENCY=4
# Optional container path for an explicitly verified GTFS-to-ETM route map.
SAFARNAMA_ML_ROUTE_MAPPING=
# Store the authorized Delhi live feed key outside the repository.
SAFARNAMA_LIVE_ENABLED=false
SAFARNAMA_DELHI_LIVE_KEY=

# Optional PostgreSQL URL for a separately hosted backend. Local Compose uses SQLite.
# SAFARNAMA_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
