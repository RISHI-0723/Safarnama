SAFARNAMA_DATABASE_URL=sqlite:///./data/safarnama.db
SAFARNAMA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAFARNAMA_LOG_LEVEL=INFO
# Optional absolute override. An explicitly empty value disables historical demand.
# SAFARNAMA_ML_ARTIFACT_DIR=/absolute/path/to/ml/outputs

# Hosted backend alternative. Use the provider's TLS connection string.
# SAFARNAMA_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
